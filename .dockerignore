# Control de versiones
.git
.gitignore

# Artefactos de build locales (se generan dentro del contenedor)
.next
out
build

# Dependencias locales (se instalan desde el lockfile dentro del contenedor)
node_modules

# Archivos de entorno (se inyectan vía docker-compose o --env-file)
.env
.env.*
!.env.example

# Documentación y archivos de configuración de IDE
README.md
*.md
.vscode
.idea

# Archivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db
